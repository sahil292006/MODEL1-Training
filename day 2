<!DOCTYPE html>
<html>
<head>
    <title>Student Registration Form</title>

    <style>
        body {
            background-color: lightblue;
            font-family: Arial;
            text-align: center;
        }

        h1 {
            color: darkblue;
            font-size: 30px;
            margin-top: 30px;
        }

        form {
            background-color: white;
            width: 400px;
            margin: 20px auto;
            padding: 30px;
            border: 2px solid darkblue;
            border-radius: 10px;
        }

        label {
            display: block;
            text-align: left;
            font-weight: bold;
            margin-bottom: 5px;
            color: darkblue;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"],
        input[type="tel"] {
            width: 100%;
            height: 35px;
            padding: 5px;
            margin-bottom: 15px;
            border: 1px solid gray;
            border-radius: 5px;
            font-size: 15px;
        }

        select {
            width: 100%;
            height: 35px;
            padding: 5px;
            margin-bottom: 15px;
            border: 1px solid gray;
            border-radius: 5px;
            font-size: 15px;
        }

        textarea {
            width: 100%;
            height: 80px;
            padding: 5px;
            margin-bottom: 15px;
            border: 1px solid gray;
            border-radius: 5px;
            font-size: 15px;
        }

        .radio-group {
            text-align: left;
            margin-bottom: 15px;
        }

        .radio-group input {
            margin-right: 5px;
        }

        .radio-group label {
            display: inline;
            font-weight: normal;
            margin-right: 15px;
        }

        input[type="file"] {
            display: block;
            margin-bottom: 15px;
            font-size: 14px;
        }

        input[type="submit"] {
            background-color: darkblue;
            color: white;
            padding: 10px 30px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            margin-right: 10px;
        }

        input[type="submit"]:hover {
            background-color: blue;
        }

        input[type="reset"] {
            background-color: gray;
            color: white;
            padding: 10px 30px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
        }

        input[type="reset"]:hover {
            background-color: darkgray;
        }
    </style>
</head>
<body>

    <h1>Student Registration Form</h1>

    <form>

        <label for="name">Name:</label>
        <input type="text" id="name" name="name" placeholder="Enter your name" required>

        <label for="enrollment">Enrollment:</label>
        <input type="text" id="enrollment" name="Enrollment" placeholder="Enter enrollment number" required>

        <label for="branch">Branch:</label>
        <select id="branch" name="Branch">
            <option value="CSE">CSE</option>
            <option value="CE">CE</option>
            <option value="IT">IT</option>
        </select>

        <label for="division">Division:</label>
        <input type="text" id="division" name="division" placeholder="e.g. A" maxlength="1" pattern="[a-zA-Z]" required>

        <label>Gender:</label>
        <div class="radio-group">
            <input type="radio" id="male" name="gender" value="male">
            <label for="male">Male</label>
            <input type="radio" id="female" name="gender" value="female">
            <label for="female">Female</label>
        </div>

        <label for="mobile">Mobile Number:</label>
        <input type="tel" id="mobile" name="mobile" placeholder="10-digit number" maxlength="10" required>

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" placeholder="example@email.com" required>

        <label for="password">Password:</label>
        <input type="password" id="password" name="password" placeholder="Enter password" required>

        <label for="photo">Photo:</label>
        <input type="file" id="photo" name="photo" accept="image/*">

        <label for="remarks">Remarks:</label>
        <textarea id="remarks" name="remarks" placeholder="Write any remarks..."></textarea>

        <input type="submit" value="Register">
        <input type="reset" value="Clear">

    </form>

</body>
</html>
